# Optional. If set, the backend will use Claude vision as a fallback
# for signature detection when geometric heuristics are low-confidence.
# Without it, the app still works — just deterministic-only.
ANTHROPIC_API_KEY=

# Backend HTTP port. Vite proxies /api here in dev.
PORT=3001

# Max upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400
